# ----------------------------------------------------------------------------
# 应用服务配置
# ----------------------------------------------------------------------------
# 运行模式 (生产环境建议使用 release)
GIN_MODE=release
# 日志级别 (生产环境建议使用 info 或 warn)
LOG_LEVEL=info
# 应用环境标识
APP_ENV=production

# ----------------------------------------------------------------------------
# 高级配置 (通常不需要修改)
# ----------------------------------------------------------------------------
# 服务器配置
SERVER_HOST=0.0.0.0
APP_PORT=8080
# 数据库连接配置
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=Ab123456
DB_DATABASE=docker_sync
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local

# 日志文件路径
LOG_FILE_PATH=/app/logs/app.log

# ============================================================================
# 配置说明和使用指南
# ============================================================================
#
# 1. Git仓库类型选择：
#    - 设置 GIT_REPOSITORY_TYPE=gitee 使用Gitee仓库
#    - 设置 GIT_REPOSITORY_TYPE=github 使用GitHub仓库
#
# 2. 认证配置：
#    - Gitee: 支持密码认证和Token认证（推荐Token）
#    - GitHub: 仅支持Personal Access Token认证
#
# 3. API模式说明：
#    - 现在使用API模式，无需配置本地Git路径
#    - 系统会自动处理Git仓库的拉取和推送操作
#
# 4. 部署方式：
#    - 使用docker-compose-all.yml（不包含MySQL）
#    - 使用docker-compose-all-mysql.yml（包含MySQL）
#
# ============================================================================