# ================================
# 多阶段构建 Dockerfile
# 包含前端构建、后端构建和最终运行环境
# ================================

# ================================
# 阶段1: 前端构建
# 产物为纯静态文件，与 CPU 架构无关，固定在构建机架构运行以加速多架构构建
# ================================
FROM --platform=$BUILDPLATFORM registry.cn-hangzhou.aliyuncs.com/lpx03/node:18-alpine AS frontend-builder

# 设置工作目录
WORKDIR /app/web

# 配置国内 npm 镜像源
RUN npm config set registry https://registry.npmmirror.com/ && \
    npm config set cache /tmp/.npm

# 复制前端项目文件
COPY web/package*.json ./

# 安装依赖
RUN npm ci --no-audit --no-fund

# 复制前端源代码
COPY web/ ./

# 构建前端项目
RUN npm run build

# ================================
# 阶段2: 后端构建
# 固定在构建机架构运行，通过 GOARCH 交叉编译出目标架构（多架构支持）
# ================================
FROM --platform=$BUILDPLATFORM registry.cn-hangzhou.aliyuncs.com/lpx03/golang:1.26.1-alpine3.23 AS backend-builder

# 目标架构由 buildx 自动注入（本地构建时为宿主架构）
ARG TARGETARCH

# 设置工作目录
WORKDIR /app

# 配置国内 Go 模块代理
ENV GOPROXY=https://goproxy.cn,direct
ENV GOSUMDB=sum.golang.google.cn
ENV GO111MODULE=on

# 使用apk的国内镜像
#RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 安装必要的包
RUN apk add --no-cache git ca-certificates tzdata

# 复制 go mod 文件
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制后端源代码
COPY . .

# 构建后端应用（交叉编译到目标架构）
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -a -installsuffix cgo \
    -ldflags="-w -s" \
    -o main main.go

# ================================
# 阶段3: 最终运行环境
# ================================
FROM registry.cn-hangzhou.aliyuncs.com/lpx03/nginx:1.25-alpine

# 使用apk的国内镜像
#RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories 
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# 安装必要的包
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    supervisor \
    git \
    && rm -rf /var/cache/apk/*

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 创建应用用户和目录
RUN addgroup -g 1001 appgroup && \
    adduser -D -u 1001 -G appgroup appuser && \
    mkdir -p /app/logs /app/sql /var/log/supervisor

# 设置工作目录
WORKDIR /app

# 从后端构建阶段复制二进制文件和配置
COPY --from=backend-builder /app/main ./
#COPY --from=backend-builder /app/config.yaml ./
#COPY --from=backend-builder /app/sql ./sql

# 从前端构建阶段复制静态文件到 nginx 目录
COPY --from=frontend-builder /app/web/dist /usr/share/nginx/html

# 复制 nginx 配置文件
COPY deploy/docker-all/nginx-all.conf /etc/nginx/nginx.conf

# 复制 supervisor 配置文件
COPY deploy/docker-all/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# 设置权限：appuser 拥有应用目录，nginx 由 root 管理
RUN chown -R appuser:appgroup /app && \
    chmod +x /app/main && \
    chown -R appuser:appgroup /var/log/supervisor

# 暴露端口
EXPOSE 80 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# 启动 supervisor 来管理 nginx 和后端服务
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]