# ============================================================================
# Docker镜像同步平台 - 环境变量配置文件
# ============================================================================
# 
# 本文件包含了系统运行所需的所有环境变量配置
# 
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据您的实际环境修改相应的配置值
# 3. 确保不要将包含真实密码的 .env 文件提交到版本控制系统
# 
# 配置优先级：
# 环境变量 > .env文件 > config.yaml > 默认值
# 
# ============================================================================

# ----------------------------------------------------------------------------
# 数据库配置 (MySQL)
# ----------------------------------------------------------------------------

# MySQL root用户密码
# 安全建议：使用强密码，包含大小写字母、数字和特殊字符
# 生产环境：建议使用至少16位的复杂密码
MYSQL_ROOT_PASSWORD=root123456

# 应用数据库名称
# 系统会自动创建此数据库，无需手动创建
MYSQL_DATABASE=docker_sync

# 应用数据库用户名
# 建议使用专用用户而非root用户，遵循最小权限原则
MYSQL_USER=docker_sync

# 应用数据库用户密码
# 此用户仅对指定数据库有权限，提高安全性
MYSQL_PASSWORD=sync123456

# 数据库端口（可选）
# 默认：3306，如有端口冲突可修改
MYSQL_PORT=3306

# ----------------------------------------------------------------------------
# 应用服务配置
# ----------------------------------------------------------------------------

# Gin框架运行模式
# debug: 开发模式，详细日志输出，启用调试功能
# release: 生产模式，优化性能，减少日志输出
# test: 测试模式，用于单元测试和集成测试
GIN_MODE=release

# 日志级别
# debug: 输出所有日志，包括详细的调试信息
# info: 输出一般信息、警告和错误（推荐生产环境）
# warn: 只输出警告和错误信息
# error: 只输出错误信息
LOG_LEVEL=info

# 应用运行环境标识
# development: 开发环境
# staging: 预发布环境
# production: 生产环境
APP_ENV=production

# ----------------------------------------------------------------------------
# 服务器网络配置
# ----------------------------------------------------------------------------

# 应用服务端口
# 默认：8080，确保端口未被其他服务占用
APP_PORT=8080

# 前端服务端口
# 默认：80，生产环境通常使用80端口
FRONTEND_PORT=80

# HTTPS端口（可选）
# 如需启用HTTPS，配置此端口和SSL证书
FRONTEND_HTTPS_PORT=443

# 服务器监听地址
# 0.0.0.0: 监听所有网络接口（推荐）
# 127.0.0.1: 仅监听本地回环接口
SERVER_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# Git仓库配置 (Gitee)
# ----------------------------------------------------------------------------

# Gitee仓库URL
# 格式：https://gitee.com/用户名/仓库名.git
# 用于存储Docker镜像列表文件
GITEE_REPO_URL=https://gitee.com/your-username/docker-images.git

# Gitee用户名
# 您的Gitee账号用户名
GITEE_USERNAME=your-username

# Gitee密码或访问令牌
# 建议使用访问令牌而非密码，安全性更高
# 获取方式：Gitee -> 设置 -> 私人令牌
GITEE_PASSWORD=your-password-or-token

# Git提交邮箱
# 用于Git提交时的作者信息
GITEE_EMAIL=your-email@example.com

# ----------------------------------------------------------------------------
# Git仓库配置 (GitHub)
# ----------------------------------------------------------------------------

# GitHub仓库URL
# 格式：https://github.com/用户名/仓库名.git
GITHUB_REPO_URL=https://github.com/your-username/docker-images.git

# GitHub用户名
# 您的GitHub账号用户名
GITHUB_USERNAME=your-username

# GitHub Personal Access Token
# 必须使用Personal Access Token，不支持密码认证
# 获取方式：GitHub -> Settings -> Developer settings -> Personal access tokens
# 所需权限：repo（仓库访问权限）
GITHUB_TOKEN=REDACTED_GITHUB_TOKEN

# ----------------------------------------------------------------------------
# 阿里云容器镜像服务 (ACR) 配置
# ----------------------------------------------------------------------------

# 阿里云镜像仓库地址
# 不同地域的仓库地址：
# - 华东1（杭州）：registry.cn-hangzhou.aliyuncs.com
# - 华北2（北京）：registry.cn-beijing.aliyuncs.com
# - 华东2（上海）：registry.cn-shanghai.aliyuncs.com
# - 华南1（深圳）：registry.cn-shenzhen.aliyuncs.com
ALIYUN_REGISTRY=registry.cn-hangzhou.aliyuncs.com

# 阿里云镜像命名空间
# 在阿里云控制台创建的命名空间名称
# 用于组织和管理Docker镜像
ALIYUN_NAMESPACE=your-namespace

# 阿里云容器镜像服务用户名
# 通常是您的阿里云账号或RAM用户名
ALIYUN_USERNAME=your-aliyun-username

# 阿里云容器镜像服务密码
# 在阿里云控制台设置的独立密码（非登录密码）
# 获取方式：容器镜像服务 -> 访问凭证 -> 设置Registry登录密码
ALIYUN_PASSWORD=your-aliyun-password

# ----------------------------------------------------------------------------
# 同步任务配置
# ----------------------------------------------------------------------------

# 同步任务超时时间（分钟）
# 单个镜像同步的最大执行时间
# 建议根据网络环境和镜像大小调整：
# - 国内网络：30-60分钟
# - 海外网络：60-120分钟
# - 大型镜像：可适当延长
SYNC_TIMEOUT_MINUTES=30

# 并发同步任务数量
# 同时执行的镜像同步任务数量
# 建议根据服务器性能和网络带宽调整：
# - 小型服务器：1-2个
# - 中型服务器：3-5个
# - 大型服务器：5-10个
SYNC_CONCURRENT_JOBS=3

# ----------------------------------------------------------------------------
# 安全配置
# ----------------------------------------------------------------------------

# API访问密钥（可选）
# 如需启用API认证，设置此密钥
# 建议使用随机生成的32位字符串
# API_SECRET_KEY=your-32-character-secret-key

# JWT密钥（可选）
# 如需启用用户认证，设置JWT签名密钥
# 建议使用随机生成的64位字符串
# JWT_SECRET=your-64-character-jwt-secret

# 允许的跨域源（可选）
# 多个源用逗号分隔，* 表示允许所有源
# 生产环境建议指定具体的域名
CORS_ALLOWED_ORIGINS=*

# ----------------------------------------------------------------------------
# 监控和告警配置（可选）
# ----------------------------------------------------------------------------

# 邮件通知配置
# SMTP服务器地址
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@example.com
# SMTP_PASSWORD=your-email-password

# 钉钉机器人Webhook（可选）
# 用于发送同步状态通知
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 企业微信机器人Webhook（可选）
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ----------------------------------------------------------------------------
# 高级配置（通常无需修改）
# ----------------------------------------------------------------------------

# Docker守护进程地址
# 默认使用本地Docker守护进程
# DOCKER_HOST=unix:///var/run/docker.sock

# 镜像拉取重试次数
# 网络不稳定时的重试次数
# DOCKER_PULL_RETRIES=3

# 镜像推送重试次数
# DOCKER_PUSH_RETRIES=3

# Git操作超时时间（秒）
# Git克隆和推送的超时时间
# GIT_TIMEOUT=300

# ============================================================================
# 配置验证清单
# ============================================================================
# 
# 部署前请确认以下配置已正确设置：
# 
# ✅ 数据库配置
#    - MYSQL_ROOT_PASSWORD: 已设置强密码
#    - MYSQL_USER/MYSQL_PASSWORD: 已设置应用用户
# 
# ✅ Git仓库配置
#    - GITEE_REPO_URL: 已创建Gitee仓库
#    - GITEE_USERNAME/GITEE_PASSWORD: 已设置正确的认证信息
#    - GITHUB_REPO_URL: 已创建GitHub仓库（可选）
#    - GITHUB_TOKEN: 已生成Personal Access Token（可选）
# 
# ✅ 阿里云ACR配置
#    - ALIYUN_REGISTRY: 已选择合适的地域
#    - ALIYUN_NAMESPACE: 已在控制台创建命名空间
#    - ALIYUN_USERNAME/ALIYUN_PASSWORD: 已设置访问凭证
# 
# ✅ 网络配置
#    - APP_PORT/FRONTEND_PORT: 确保端口未被占用
#    - 防火墙已开放相应端口
# 
# ============================================================================