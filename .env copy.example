# 数据库配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=docker_sync
MYSQL_USER=docker_sync
MYSQL_PASSWORD=sync123456

# 应用配置
GIN_MODE=release
LOG_LEVEL=info

# Git配置
GIT_REPO_URL=https://gitee.com/your-username/docker-images.git
GIT_USERNAME=your-username
GIT_PASSWORD=your-password
GIT_EMAIL=your-email@example.com

# GitHub配置
GITHUB_TOKEN=your-github-token
GITHUB_REPO_URL=https://github.com/your-username/docker-images

# 阿里云配置
ALIYUN_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ALIYUN_NAMESPACE=your-namespace

# 服务器配置
SERVER_PORT=8080
SERVER_HOST=0.0.0.0